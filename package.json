{
  "name": "relay-drone-delivery",
  "private": true,
  "version": "0.1.0",
  "description": "Relay \u2014 drone delivery and drone rental across London (The Problem Day hackathon)",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "concurrently -k -n web,api -c cyan,magenta \"vite\" \"tsx watch server/index.ts\"",
    "dev:phone": "concurrently -k -n web,api -c cyan,magenta \"vite --host\" \"tsx watch server/index.ts\"",
    "dev:web": "vite",
    "dev:api": "tsx watch server/index.ts",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "build:pages": "VITE_BASE=/relay/ tsc --noEmit -p tsconfig.json && VITE_BASE=/relay/ vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "tsx server/index.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "@deck.gl/core": "9.4.1",
    "@deck.gl/layers": "9.4.1",
    "@deck.gl/mapbox": "9.4.1",
    "@fontsource/inter": "5.3.0",
    "@fontsource/montserrat": "5.3.0",
    "clsx": "2.1.1",
    "dotenv": "18.0.9",
    "express": "5.3.0",
    "lucide-react": "1.66.0",
    "maplibre-gl": "5.24.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.5",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/express": "5.0.6",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "concurrently": "10.0.6",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.5"
  }
}
